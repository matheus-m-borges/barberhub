// BarberHub Pro ERP - Prisma Schema
// PostgreSQL Production & Multi-tenant isolation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// NÚCLEO & MULTI-TENANT
// ----------------------------------------------------

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  document  String?
  phone     String?
  email     String?
  status    String   @default("ACTIVE") // ACTIVE, SUSPENDED, CANCELED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  units                 Unit[]
  users                 User[]
  roles                 Role[]
  sessions              Session[]
  auditLogs             AuditLog[]
  customers             Customer[]
  customerNotes         CustomerNote[]
  serviceCategories     ServiceCategory[]
  services              Service[]
  employees             Employee[]
  businessSettings      BusinessSetting?
  appointments          Appointment[]
  scheduleBlocks        ScheduleBlock[]
  waitingList           WaitingList[]
  cashRegisters         CashRegister[]
  sales                 Sale[]
  financialCategories   FinancialCategory[]
  financialTransactions FinancialTransaction[]
  accountsPayable       AccountPayable[]
  accountsReceivable    AccountReceivable[]
  employeeCommissions   EmployeeCommission[]
  productCategories     ProductCategory[]
  suppliers             Supplier[]
  products              Product[]
  stockMovements        StockMovement[]
  purchaseOrders        PurchaseOrder[]
  loyaltyAccounts       LoyaltyAccount[]
  loyaltyTransactions   LoyaltyTransaction[]
  loyaltyRewards        LoyaltyReward[]
  subscriptionPlans     SubscriptionPlan[]
  customerSubscriptions CustomerSubscription[]
  coupons               Coupon[]

  @@map("tenants")
}

model Unit {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users                 User[]
  employees             Employee[]
  auditLogs             AuditLog[]
  appointments          Appointment[]
  cashRegisters         CashRegister[]
  sales                 Sale[]
  financialTransactions FinancialTransaction[]
  accountsPayable       AccountPayable[]
  accountsReceivable    AccountReceivable[]
  purchaseOrders        PurchaseOrder[]

  @@index([tenantId])
  @@map("units")
}

model User {
  id             String    @id @default(cuid())
  tenantId       String
  unitId         String?
  name           String
  email          String
  phone          String?
  passwordHash   String
  status         String    @default("ACTIVE") // ACTIVE, INACTIVE, BLOCKED
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant              Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit                Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  employee            Employee?
  userRoles           UserRole[]
  sessions            Session[]
  auditLogs           AuditLog[]
  cashRegistersOpened CashRegister[]  @relation("CashRegisterOpenedBy")
  cashRegistersClosed CashRegister[]  @relation("CashRegisterClosedBy")
  salesCreated        Sale[]          @relation("SaleCreatedBy")
  stockMovements      StockMovement[]
  purchaseOrders      PurchaseOrder[] @relation("PurchaseOrderCreatedBy")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String?
  name        String
  slug        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, slug])
  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  module      String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id     String @id @default(cuid())
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  tokenHash String   @unique
  ipAddress String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tenantId])
  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  unitId    String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldValues String?
  newValues String?
  ipAddress String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit   Unit?  @relation(fields: [unitId], references: [id], onDelete: SetNull)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ----------------------------------------------------
// FASE 2: CLIENTES (CRM)
// ----------------------------------------------------

model Customer {
  id                String    @id @default(cuid())
  tenantId          String
  name              String
  phone             String
  email             String?
  cpf               String?
  birthDate         DateTime?
  address           String?
  notes             String?
  status            String    @default("ACTIVE")
  totalSpent        Decimal   @default(0.0) @db.Decimal(12, 2)
  appointmentsCount Int       @default(0)
  averageTicket     Decimal   @default(0.0) @db.Decimal(12, 2)
  lastVisitAt       DateTime?
  noShowCount       Int       @default(0)
  canceledCount     Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  notesLog              CustomerNote[]
  appointments          Appointment[]
  waitingList           WaitingList[]
  sales                 Sale[]
  accountsReceivable    AccountReceivable[]
  loyaltyAccount        LoyaltyAccount?
  customerSubscriptions CustomerSubscription[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([tenantId, name])
  @@map("customers")
}

model CustomerNote {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  authorId   String?
  content    String
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([customerId])
  @@map("customer_notes")
}

// ----------------------------------------------------
// FASE 2: SERVIÇOS & CATEGORIAS
// ----------------------------------------------------

model ServiceCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  color       String?  @default("#3b82f6")
  orderIndex  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  services Service[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("service_categories")
}

model Service {
  id              String   @id @default(cuid())
  tenantId        String
  categoryId      String?
  name            String
  description     String?
  price           Decimal  @db.Decimal(12, 2)
  durationMinutes Int
  commissionType  String   @default("PERCENTAGE")
  commissionValue Decimal  @default(0.0) @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category              ServiceCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  employeeServices      EmployeeService[]
  appointmentServices   AppointmentService[]
  waitingList           WaitingList[]
  loyaltyRewards        LoyaltyReward[]
  subscriptionPlanItems SubscriptionPlanItem[]
  subscriptionUsages    SubscriptionUsage[]

  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@map("services")
}

// ----------------------------------------------------
// FASE 2: FUNCIONÁRIOS & REPASSES
// ----------------------------------------------------

model Employee {
  id             String    @id @default(cuid())
  tenantId       String
  unitId         String?
  userId         String?   @unique
  name           String
  cpf            String?
  phone          String
  birthDate      DateTime?
  hireDate       DateTime  @default(now())
  position       String    @default("BARBEIRO")
  salary         Decimal   @default(0.0) @db.Decimal(12, 2)
  commissionRate Decimal   @default(0.0) @db.Decimal(12, 2)
  pixKey         String?
  status         String    @default("ACTIVE")
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit                Unit?                @relation(fields: [unitId], references: [id], onDelete: SetNull)
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeServices    EmployeeService[]
  appointments        Appointment[]
  scheduleBlocks      ScheduleBlock[]
  waitingList         WaitingList[]
  saleItems           SaleItem[]
  employeeCommissions EmployeeCommission[]

  @@unique([tenantId, phone])
  @@index([tenantId])
  @@map("employees")
}

model EmployeeService {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String
  serviceId  String
  customRate Decimal? @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([employeeId, serviceId])
  @@index([tenantId])
  @@map("employee_services")
}

// ----------------------------------------------------
// FASE 2: CONFIGURAÇÕES DA BARBEARIA
// ----------------------------------------------------

model BusinessSetting {
  id                       String   @id @default(cuid())
  tenantId                 String   @unique
  businessName             String
  weekdayOpeningTime       String   @default("09:00")
  weekdayClosingTime       String   @default("19:00")
  intervalMinutes          Int      @default(30)
  appointmentBufferMinutes Int      @default(0)
  cancellationGraceMinutes Int      @default(120)
  enableOnlineBooking      Boolean  @default(true)
  requirePhoneConfirmation Boolean  @default(false)
  updatedAt                DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("business_settings")
}

// ----------------------------------------------------
// FASE 3: AGENDA, AGENDAMENTOS & LISTA DE ESPERA
// ----------------------------------------------------

model Appointment {
  id                 String    @id @default(cuid())
  tenantId           String
  unitId             String?
  code               String
  token              String    @unique
  origin             String    @default("SITE") // SITE, BOT, PORTAL_CLIENTE, RECEPCAO, TELEFONE, WHATSAPP_MANUAL, ENCAIXE
  customerId         String
  employeeId         String
  startTime          DateTime
  endTime            DateTime
  durationMinutes    Int
  totalPrice         Decimal   @db.Decimal(12, 2)
  status             String    @default("AGENDADO")
  isFitting          Boolean   @default(false)
  notes              String?
  cancellationReason String?
  canceledAt         DateTime?
  rescheduledFromId  String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant             Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit               Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)
  customer           Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  employee           Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  services           AppointmentService[]
  statusHistory      AppointmentStatusHistory[]
  sales              Sale[]
  subscriptionUsages SubscriptionUsage[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, employeeId, startTime])
  @@index([tenantId, status])
  @@index([startTime, endTime])
  @@map("appointments")
}

model AppointmentService {
  id              String  @id @default(cuid())
  appointmentId   String
  serviceId       String
  price           Decimal @db.Decimal(12, 2)
  durationMinutes Int
  commissionValue Decimal @default(0.0) @db.Decimal(12, 2)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, serviceId])
  @@map("appointment_services")
}

model AppointmentStatusHistory {
  id             String   @id @default(cuid())
  appointmentId  String
  previousStatus String?
  newStatus      String
  reason         String?
  changedById    String?
  createdAt      DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@map("appointment_status_history")
}

model ScheduleBlock {
  id         String   @id @default(cuid())
  tenantId   String
  employeeId String?
  title      String
  reason     String?
  startTime  DateTime
  endTime    DateTime
  createdAt  DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([employeeId, startTime, endTime])
  @@map("schedule_blocks")
}

model WaitingList {
  id              String   @id @default(cuid())
  tenantId        String
  customerId      String
  serviceId       String
  employeeId      String?
  preferredDate   DateTime
  preferredPeriod String   @default("QUALQUER")
  priority        Int      @default(1)
  status          String   @default("WAITING")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([tenantId, preferredDate, status])
  @@map("waiting_list")
}

// ----------------------------------------------------
// FASE 4: FRENTE DE CAIXA (PDV), CAIXA & PAGAMENTOS
// ----------------------------------------------------

model CashRegister {
  id              String    @id @default(cuid())
  tenantId        String
  unitId          String?
  openedById      String
  closedById      String?
  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  initialBalance  Decimal   @default(0.0) @db.Decimal(12, 2)
  expectedBalance Decimal?  @db.Decimal(12, 2)
  countedBalance  Decimal?  @db.Decimal(12, 2)
  difference      Decimal?  @db.Decimal(12, 2)
  status          String    @default("OPEN")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit      Unit?          @relation(fields: [unitId], references: [id], onDelete: SetNull)
  openedBy  User           @relation("CashRegisterOpenedBy", fields: [openedById], references: [id], onDelete: Cascade)
  closedBy  User?          @relation("CashRegisterClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  movements CashMovement[]
  sales     Sale[]

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("cash_registers")
}

model CashMovement {
  id             String   @id @default(cuid())
  cashRegisterId String
  tenantId       String
  userId         String
  type           String
  amount         Decimal  @db.Decimal(12, 2)
  paymentMethod  String   @default("CASH")
  reason         String?
  saleId         String?
  createdAt      DateTime @default(now())

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)

  @@index([cashRegisterId])
  @@index([tenantId])
  @@map("cash_movements")
}

model Sale {
  id                 String    @id @default(cuid())
  tenantId           String
  unitId             String?
  code               String
  cashRegisterId     String
  customerId         String?
  appointmentId      String?
  createdById        String
  subtotal           Decimal   @db.Decimal(12, 2)
  discount           Decimal   @default(0.0) @db.Decimal(12, 2)
  total              Decimal   @db.Decimal(12, 2)
  status             String    @default("COMPLETED")
  canceledAt         DateTime?
  cancellationReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant              Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit                Unit?                @relation(fields: [unitId], references: [id], onDelete: SetNull)
  cashRegister        CashRegister         @relation(fields: [cashRegisterId], references: [id], onDelete: Cascade)
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  appointment         Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  createdBy           User                 @relation("SaleCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  items               SaleItem[]
  payments            Payment[]
  employeeCommissions EmployeeCommission[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([cashRegisterId])
  @@index([tenantId, status])
  @@map("sales")
}

model SaleItem {
  id               String  @id @default(cuid())
  saleId           String
  itemType         String  @default("SERVICE")
  itemId           String
  name             String
  employeeId       String?
  unitPrice        Decimal @db.Decimal(12, 2)
  quantity         Int     @default(1)
  totalPrice       Decimal @db.Decimal(12, 2)
  commissionRate   Decimal @default(0.0) @db.Decimal(12, 2)
  commissionAmount Decimal @default(0.0) @db.Decimal(12, 2)

  sale     Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([saleId])
  @@index([employeeId])
  @@map("sale_items")
}

model Payment {
  id           String   @id @default(cuid())
  saleId       String
  tenantId     String
  method       String
  amount       Decimal  @db.Decimal(12, 2)
  amountPaid   Decimal? @db.Decimal(12, 2)
  changeAmount Decimal? @default(0.0) @db.Decimal(12, 2)
  notes        String?
  createdAt    DateTime @default(now())

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([tenantId])
  @@map("payments")
}

// ----------------------------------------------------
// FASE 5: GESTÃO FINANCEIRA, COMISSÕES & FLUXO DE CAIXA
// ----------------------------------------------------

model FinancialCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  type        String
  description String?
  color       String?  @default("#10b981")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transactions          FinancialTransaction[]
  accountsPayable       AccountPayable[]
  accountsReceivable    AccountReceivable[]

  @@unique([tenantId, name, type])
  @@index([tenantId])
  @@map("financial_categories")
}

model FinancialTransaction {
  id                 String    @id @default(cuid())
  tenantId           String
  unitId             String?
  categoryId         String
  type               String
  amount             Decimal   @db.Decimal(12, 2)
  paymentMethod      String
  description        String
  date               DateTime  @default(now())
  saleId             String?
  status             String    @default("CONFIRMED")
  canceledAt         DateTime?
  cancellationReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit     Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  category FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, date])
  @@index([tenantId, type])
  @@map("financial_transactions")
}

model AccountPayable {
  id            String    @id @default(cuid())
  tenantId      String
  unitId        String?
  categoryId    String
  supplierName  String
  description   String
  amount        Decimal   @db.Decimal(12, 2)
  dueDate       DateTime
  paidAt        DateTime?
  paidAmount    Decimal?  @db.Decimal(12, 2)
  paymentMethod String?
  status        String    @default("PENDING")
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit     Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  category FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, dueDate, status])
  @@map("accounts_payable")
}

model AccountReceivable {
  id             String    @id @default(cuid())
  tenantId       String
  unitId         String?
  customerId     String?
  categoryId     String
  description    String
  amount         Decimal   @db.Decimal(12, 2)
  dueDate        DateTime
  receivedAt     DateTime?
  receivedAmount Decimal?  @db.Decimal(12, 2)
  paymentMethod  String?
  status         String    @default("PENDING")
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant   Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit     Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  customer Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  category FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, dueDate, status])
  @@map("accounts_receivable")
}

model EmployeeCommission {
  id                 String    @id @default(cuid())
  tenantId           String
  employeeId         String
  saleId             String
  saleItemId         String?
  serviceName        String
  servicePrice       Decimal   @db.Decimal(12, 2)
  commissionRate     Decimal   @db.Decimal(12, 2)
  commissionAmount   Decimal   @db.Decimal(12, 2)
  status             String    @default("PENDING")
  paidAt             DateTime?
  cancellationReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sale     Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, employeeId, status])
  @@index([saleId])
  @@map("employee_commissions")
}

// ----------------------------------------------------
// FASE 6: ESTOQUE, PRODUTOS, FORNECEDORES & COMPRAS
// ----------------------------------------------------

model ProductCategory {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("product_categories")
}

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  tradeName String?
  document  String?
  phone     String?
  email     String?
  address   String?
  pixKey    String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  products       Product[]
  purchaseOrders PurchaseOrder[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("suppliers")
}

model Product {
  id           String   @id @default(cuid())
  tenantId     String
  categoryId   String?
  supplierId   String?
  name         String
  sku          String?
  barcode      String?
  costPrice    Decimal  @default(0.0) @db.Decimal(12, 2)
  salePrice    Decimal  @default(0.0) @db.Decimal(12, 2)
  currentStock Int      @default(0)
  minStock     Int      @default(5)
  unit         String   @default("UN")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  stockMovements StockMovement[]
  purchaseItems  PurchaseItem[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, sku])
  @@map("products")
}

model StockMovement {
  id              String   @id @default(cuid())
  tenantId        String
  productId       String
  userId          String
  type            String
  quantity        Int
  previousStock   Int
  newStock        Int
  unitCost        Decimal  @default(0.0) @db.Decimal(12, 2)
  reason          String?
  saleId          String?
  purchaseOrderId String?
  createdAt       DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([productId])
  @@index([tenantId, type])
  @@map("stock_movements")
}

model PurchaseOrder {
  id                   String    @id @default(cuid())
  tenantId             String
  unitId               String?
  supplierId           String
  code                 String
  createdById          String
  status               String    @default("DRAFT")
  totalAmount          Decimal   @default(0.0) @db.Decimal(12, 2)
  expectedDeliveryDate DateTime?
  receivedAt           DateTime?
  notes                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit           Unit?           @relation(fields: [unitId], references: [id], onDelete: SetNull)
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  createdBy      User            @relation("PurchaseOrderCreatedBy", fields: [createdById], references: [id], onDelete: Cascade)
  items          PurchaseItem[]
  stockMovements StockMovement[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([supplierId])
  @@index([tenantId, status])
  @@map("purchase_orders")
}

model PurchaseItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitCost        Decimal @db.Decimal(12, 2)
  totalCost       Decimal @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([purchaseOrderId, productId])
  @@map("purchase_items")
}

// ----------------------------------------------------
// FASE 7: FIDELIDADE, PLANOS, CUPONS & PROMOÇÕES
// ----------------------------------------------------

model LoyaltyAccount {
  id             String   @id @default(cuid())
  tenantId       String
  customerId     String   @unique
  currentPoints  Int      @default(0)
  lifetimePoints Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  transactions LoyaltyTransaction[]

  @@unique([tenantId, customerId])
  @@index([tenantId])
  @@map("loyalty_accounts")
}

model LoyaltyTransaction {
  id               String   @id @default(cuid())
  tenantId         String
  loyaltyAccountId String
  type             String   // CREDIT (crédito por compra), DEBIT (resgate de prêmio)
  points           Int
  previousPoints   Int
  newPoints        Int
  saleId           String?
  rewardId         String?
  reason           String?
  createdAt        DateTime @default(now())

  tenant         Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  loyaltyAccount LoyaltyAccount @relation(fields: [loyaltyAccountId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([loyaltyAccountId])
  @@map("loyalty_transactions")
}

model LoyaltyReward {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  pointsRequired Int
  serviceId      String?
  productId      String?
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@map("loyalty_rewards")
}

model SubscriptionPlan {
  id           String   @id @default(cuid())
  tenantId     String
  name         String
  price        Decimal  @db.Decimal(12, 2)
  intervalDays Int      @default(30)
  description  String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant        Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items         SubscriptionPlanItem[]
  subscriptions CustomerSubscription[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("subscription_plans")
}

model SubscriptionPlanItem {
  id              String @id @default(cuid())
  planId          String
  serviceId       String
  quantityAllowed Int    // Número de utilizações permitidas por ciclo

  plan    SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  service Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([planId, serviceId])
  @@map("subscription_plan_items")
}

model CustomerSubscription {
  id         String    @id @default(cuid())
  tenantId   String
  customerId String
  planId     String
  startDate  DateTime  @default(now())
  endDate    DateTime
  status     String    @default("ACTIVE") // ACTIVE, SUSPENDED, CANCELED
  canceledAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  usages   SubscriptionUsage[]

  @@index([tenantId])
  @@index([customerId])
  @@index([tenantId, status])
  @@map("customer_subscriptions")
}

model SubscriptionUsage {
  id             String   @id @default(cuid())
  subscriptionId String
  serviceId      String
  appointmentId  String?
  usedAt         DateTime @default(now())

  subscription CustomerSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  service      Service              @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  appointment  Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@map("subscription_usages")
}

model Coupon {
  id             String    @id @default(cuid())
  tenantId       String
  code           String
  discountType   String    @default("PERCENTAGE") // PERCENTAGE, FIXED
  discountValue  Decimal   @db.Decimal(12, 2)
  minOrderAmount Decimal   @default(0.0) @db.Decimal(12, 2)
  maxUses        Int?
  currentUses    Int       @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, code, isActive])
  @@map("coupons")
}
